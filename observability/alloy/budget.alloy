// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). S5 reserves half for the LLM and later stages.

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		rule {
			source_labels = ["__name__"]
			regex         = "up|node_cpu_seconds_total|node_load[15]|node_memory_(MemAvailable|MemTotal)_bytes|node_filesystem_(avail|size)_bytes|node_network_(receive|transmit)_(bytes|errs|drop)_total"
			action        = "keep"
		}

		// Keep the root filesystem. Docker and bind mounts change across deployments.
		rule {
			source_labels = ["__name__", "mountpoint"]
			regex         = "node_filesystem_.*;/.+"
			action        = "drop"
		}

		rule {
			source_labels = ["__name__", "device"]
			regex         = "node_network_.*;(veth.*|br-.*|docker.*|lo)"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		rule {
			source_labels = ["__name__"]
			regex         = "up|container_memory_working_set_bytes|container_cpu_usage_seconds_total"
			action        = "keep"
		}

		// Host and parent cgroups lack a Docker name. Retain named containers for the dashboard.
		rule {
			source_labels = ["__name__", "name"]
			regex         = "container_.*;"
			action        = "drop"
		}

		// A container name is stable across recreation. The ID, image SHA and labels can change.
		rule {
			regex  = "id|image|container_label_.*"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		rule {
			source_labels = ["__name__"]
			regex         = "up|lab_http_requests_total|lab_(http_request|serving_request|model_predict)_duration_seconds_(bucket|sum|count)|lab_predictions_total|lab_model_info|lab_model_reloads_total|traefik_(entrypoint|service)_requests_total|traefik_service_request_duration_seconds_(bucket|sum|count)"
			action        = "keep"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
